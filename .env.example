# Configuration Mon Espace Client Pro - Portail Sécurisé Cabinet
# Copier ce fichier en .env et ajuster les valeurs

# Base de données
DB_HOST=localhost
DB_NAME=mon_espace_client_pro
DB_USER=votre_utilisateur
DB_PASS=votre_mot_de_passe
DB_CHARSET=utf8mb4

# Application
APP_NAME="Mon Espace Client Pro"
APP_URL=https://votre-domaine.fr
APP_ENV=production
APP_DEBUG=false
APP_TIMEZONE=America/Guadeloupe

# Sécurité
SESSION_LIFETIME=7200
CSRF_TOKEN_NAME=csrf_token
MAX_LOGIN_ATTEMPTS=5
LOGIN_LOCKOUT_TIME=900

# Upload
UPLOAD_MAX_SIZE=10485760
UPLOAD_ALLOWED_TYPES=pdf,jpg,jpeg,png,doc,docx,xls,xlsx,zip
UPLOAD_PATH=/uploads/documents

# Email SMTP
MAIL_HOST=smtp.example.com
MAIL_PORT=587
MAIL_USERNAME=noreply@votre-domaine.fr
MAIL_PASSWORD=votre_mot_de_passe_smtp
MAIL_ENCRYPTION=tls
MAIL_FROM_ADDRESS=noreply@votre-domaine.fr
MAIL_FROM_NAME="Mon Espace Client Pro"

# CRON
CRON_TOKEN=changez_ce_token_secret_unique_xyz123
CRON_URL=/cron.php

# Options avancées (facultatives)
ENABLE_2FA=false
ENABLE_IP_WHITELIST=false
ADMIN_IP_WHITELIST=
ENABLE_PWA=false
ENABLE_RGPD=true
FILE_RETENTION_DAYS=2555
ENABLE_WATERMARK=false
ENABLE_API=false
API_RATE_LIMIT=100
